# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zgartiring

# development | production
APP_ENV=development

# JWT imzosi uchun maxfiy kalit. Productionda MAJBURIY.
# Yaratish:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ma'lumotlar (baza va yuklangan rasmlar) saqlanadigan papka
DATA_DIR=./data

# HTTPS orqali ishlaganda true (production'da avtomatik true)
COOKIE_SECURE=false

# Kirish sahifasida demo hisoblarni ko'rsatish (haqiqiy ishga tushirganda false qiling)
DEMO_MODE=true

# To'lovdan qaytish va xatlardagi havolalar uchun sayt manzili
PUBLIC_URL=http://localhost:8000

# ---- Email (SMTP). Bo'sh bo'lsa: dev rejimda test pochta qutisi, productionda "sozlanmagan" ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CarRent <no-reply@example.com>

# ---- SMS (Eskiz.uz) ----
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---- Click (SHOP API). Callback manzili: <PUBLIC_URL>/api/payments/click ----
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ---- Payme (Merchant API). Endpoint: <PUBLIC_URL>/api/payments/payme ----
PAYME_MERCHANT_ID=
PAYME_KEY=

# Bron qilish uchun email yoki telefon tasdiqlangan bo'lishi shartmi (1 — ha, 0 — yo'q)
REQUIRE_VERIFIED_CONTACT=1
